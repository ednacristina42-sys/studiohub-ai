# StudioHub AI — backend/.env
# Copiar para backend/.env e preencher com os valores reais.
# NUNCA fazer commit do ficheiro .env real (já está no .gitignore).

# --- MongoDB (MongoDB Atlas) ---
# Connection string do cluster Atlas. Ver guia MIGRACAO_HOSTINGER.md, secção 9.
MONGO_URL=mongodb+srv://<utilizador>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiohub

# --- Autenticação ---
# Segredo usado para assinar os tokens JWT. Gerar um valor aleatório forte, ex.: openssl rand -hex 32
JWT_SECRET=

# Criação automática do primeiro utilizador administrador no arranque do backend.
# Deixar em branco depois do primeiro deploy, se preferir gerir utilizadores manualmente.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS ---
# Domínio(s) do frontend em produção, separados por vírgula. Ex.: https://app.oteudominio.pt
CORS_ORIGINS=https://app.oteudominio.pt

# --- Stripe (pagamentos) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emergent LLM (funcionalidades de IA: pesquisa em galerias, assistente) ---
# Ver aviso na secção "Dependências Emergent" do guia de migração — esta chave
# depende de um serviço externo da Emergent e pode deixar de funcionar após
# cancelarem a conta Emergent. Testar antes de cancelar.
EMERGENT_LLM_KEY=

# --- Emergent Email (envio de emails transacionais: confirmação de pagamento) ---
# Mesmo aviso que acima — depende de https://integrations.emergentagent.com
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=StudioHub AI
PHOTOGRAPHER_EMAIL=
